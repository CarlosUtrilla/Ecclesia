{
  "name": "ecclesia",
  "version": "0.8.6",
  "private": true,
  "description": "Eclesia - Monorepo",
  "author": "Carlos Utrilla",
  "homepage": "https://github.com/CarlosUtrilla/Ecclesia",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.1.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp",
      "@ffmpeg-installer/ffmpeg",
      "@prisma/client",
      "prisma",
      "electron",
      "electron-builder"
    ]
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ]
  },
  "scripts": {
    "release": "bash packages/scripts/release.sh",
    "dev": "pnpm --filter @ecclesia/desktop dev",
    "build": "pnpm --filter @ecclesia/desktop build",
    "build:ci": "pnpm --filter @ecclesia/desktop build:ci",
    "test": "pnpm --filter @ecclesia/desktop test",
    "test:watch": "pnpm --filter @ecclesia/desktop test:watch",
    "test:coverage": "pnpm --filter @ecclesia/desktop test:coverage",
    "lint": "pnpm --filter @ecclesia/desktop lint",
    "typecheck": "pnpm --filter @ecclesia/desktop typecheck",
    "format": "prettier --write .",
    "start": "pnpm --filter @ecclesia/desktop start",
    "postinstall": "pnpm --filter @ecclesia/api db:generate",
    "seed": "pnpm ts-node apps/api/prisma/seed.ts",
    "db:reset": "pnpm --filter @ecclesia/desktop db:reset",
    "db:backup": "pnpm --filter @ecclesia/desktop db:backup",
    "db:inspect": "pnpm --filter @ecclesia/desktop db:inspect",
    "sync": "git pull && pnpm --filter @ecclesia/api db:migrate"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prisma": "^6.12.0",
    "typescript": "^5.8.3"
  }
}
