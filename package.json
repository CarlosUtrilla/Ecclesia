{
  "name": "ecclesia",
  "version": "0.5.2",
  "private": true,
  "description": "Eclesia - Monorepo",
  "author": "Carlos Utrilla",
  "homepage": "https://github.com/CarlosUtrilla/Ecclesia",
  "license": "UNLICENSED",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "nohoist": [
      "**/@hookform/resolvers"
    ]
  },
  "scripts": {
    "dev": "yarn workspace @ecclesia/desktop dev",
    "build": "yarn workspace @ecclesia/desktop build",
    "build:ci": "yarn workspace @ecclesia/desktop build:ci",
    "test": "yarn workspace @ecclesia/desktop test",
    "test:watch": "yarn workspace @ecclesia/desktop test:watch",
    "test:coverage": "yarn workspace @ecclesia/desktop test:coverage",
    "lint": "yarn workspace @ecclesia/desktop lint",
    "typecheck": "yarn workspace @ecclesia/desktop typecheck",
    "format": "prettier --write .",
    "start": "yarn workspace @ecclesia/desktop start",
    "postinstall": "npx prisma generate --schema=apps/api/prisma/schema.prisma",
    "seed": "npx ts-node apps/api/prisma/seed.ts",
    "db:reset": "yarn workspace @ecclesia/desktop db:reset",
    "db:backup": "yarn workspace @ecclesia/desktop db:backup",
    "db:inspect": "yarn workspace @ecclesia/desktop db:inspect",
    "sync": "git pull && npx prisma migrate dev --schema=apps/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prisma": "^6.12.0",
    "typescript": "^5.8.3"
  }
}
