{
  "name": "@ecclesia/api",
  "version": "0.5.2",
  "private": true,
  "description": "Ecclesia - API layer (controllers, services, Prisma client)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "start:sidecar": "node dist/sidecar.js",
    "dev:sidecar": "NODE_ENV=development npx tsx src/standalone.ts"
  },
  "bin": {
    "ecclesia-sidecar": "./dist/sidecar.js"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@prisma/client": "6.19.3",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.6",
    "font-list": "^2.0.1",
    "decimal.js": "^10.6.0",
    "express": "^5.2.1",
    "fs-extra": "^11.3.0",
    "multer": "^2.1.1",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "bufferutil": "^4.0.9",
    "utf-8-validate": "^6.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/multer": "^2.1.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  }
}
