{
  "$schema": "https://raw.githubusercontent.com/nicktomlin/tauri-v2-schema/main/tauri.conf.json",
  "productName": "Ecclesia",
  "version": "0.14.4",
  "identifier": "com.ecclesia.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev:frontend",
    "beforeBuildCommand": "pnpm build:frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../api/dist/sidecar.js"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "wix": {
        "language": "es-ES"
      }
    }
  },
  "plugins": {}
}
