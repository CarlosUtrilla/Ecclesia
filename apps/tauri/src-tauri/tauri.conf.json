{
  "$schema": "https://raw.githubusercontent.com/nicktomlin/tauri-v2-schema/main/tauri.conf.json",
  "productName": "Ecclesia",
  "version": "0.16.1",
  "identifier": "com.ecclesia.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev:frontend",
    "beforeBuildCommand": "pnpm build:frontend && node scripts/bundle-sidecar-deps.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecar-deps": "sidecar-deps",
      "../../../.env": ".env"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "wix": {
        "language": "es-ES"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/CarlosUtrilla/Ecclesia/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2QzZEOThFNTUwRUJDOUEKUldTYXZBNVZqdG5HRnI0QlJoN1lOTXRIa3hEcjZ5VHRxeWVEUm1TWlNHb0Fad3k1eGxIbGNlRnoK",
      "dangerousInsecureTransportProtocol": true
    }
  }
}
